# ClauseIQ — Environment Configuration
# Copy this file to .env and fill in your values

# ─── LLM ────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here

# Which Mistral model to use for generation
# Options: open-mistral-7b | mistral-small-latest | mistral-medium-latest
MISTRAL_MODEL=mistral-small-latest

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Sentence Transformers model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ─── Retrieval ───────────────────────────────────────────────────────────────
# Number of chunks to retrieve before reranking
RETRIEVAL_TOP_K=20

# Number of chunks to pass to LLM after reranking
RERANKER_TOP_K=5

# ─── Paths ───────────────────────────────────────────────────────────────────
PDF_DIR=data/raw_pdfs
FAISS_INDEX_PATH=data/faiss_index
EVAL_SET_PATH=data/eval_set.json
